#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, j, count = 0, flag = 1;

    printf("Enter a string: ");
    scanf("%s", s);

    i = 0;
    j = strlen(s) - 1;

    while (s[i] == '0' && s[j] == '0' && i < j)
    {
        count++;
        i++;
        j--;
    }

    for (int k = i; k <= j; k++)
    {
        if (s[k] != '1')
        {
            flag = 0;
        }
    }

    if (flag == 1)
    {
        printf("String Accepted");
    }
    else
    {
        printf("String Rejected");
    }

    return 0;
}