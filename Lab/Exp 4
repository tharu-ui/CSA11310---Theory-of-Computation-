#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, flag = 1;

    printf("Enter a string: ");
    scanf("%s", s);

    for (i = 0; i < strlen(s) / 2; i++)
    {
        if (s[i] != s[strlen(s) - 1 - i])
        {
            flag = 0;
            break;
        }
    }

    if (flag == 1)
    {
        printf("String Accepted");
    }
    else
    {
        printf("String Rejected");
    }

    return 0;
}