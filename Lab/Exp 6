#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int i, count0 = 0, count1 = 0, flag = 1;

    printf("Enter a string: ");
    scanf("%s", s);

    for (i = 0; i < strlen(s); i++)
    {
        if (s[i] == '0')
        {
            count0++;
        }
        else if (s[i] == '1')
        {
            count1++;
        }
        else
        {
            flag = 0;
        }
    }

    if (count0 == count1 && flag == 1)
    {
        printf("String Accepted");
    }
    else
    {
        printf("String Rejected");
    }

    return 0;
}